# ---------------------------------------------------------------
# Fastfile — Android build & deployment lanes
# ---------------------------------------------------------------
# All logic lives in fastlane-plugin-play_publisher. This file only
# names the lanes. See that plugin's README for the full env var
# reference and the draft-app behaviour.
#
# Required env: APP_IDENTIFIER, and one of
#   PLAY_STORE_JSON_KEY_PATH / PLAY_STORE_JSON_KEY_DATA
# ---------------------------------------------------------------

default_platform(:android)

platform :android do
  desc "Build release AAB only (no upload)"
  lane :build do
    play_build
  end

  desc "Build and upload to Google Play internal testing track"
  lane :internal do
    play_publish(track: "internal")
  end

  desc "Build and upload to Google Play beta (open testing) track"
  lane :beta do
    play_publish(track: "beta")
  end

  desc "Build and upload to Google Play production track"
  lane :release do
    play_publish(track: "production", upload_metadata: true)
  end

  desc "Upload only text metadata (title, descriptions) to Play Store"
  lane :upload_metadata do
    play_upload_listing(text: true, images: false)
  end

  desc "Upload only screenshots + feature graphic / icon to Play Store"
  lane :upload_screenshots do
    play_upload_listing(text: false, images: true)
  end

  desc "Upload text metadata + images + screenshots to Play Store"
  lane :upload_listing do
    play_upload_listing
  end

  desc "Download current metadata from Play Store"
  lane :download_metadata do
    play_download_metadata
  end

  desc "Frame raw Android screenshots using frameit"
  lane :screenshots do
    frameit(
      path: "./screenshots/raw",
      output_suffix: "_framed",
      white: true,
    )
  end
end
